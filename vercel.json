{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "artifacts/invest-plus/dist/public",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "artifacts/api-server/dist/*.mjs"
    },
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "artifacts/api-server/dist/*.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__api_path=:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}